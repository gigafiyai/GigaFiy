generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Artist {
  id              String    @id @default(cuid())
  name            String
  genre           String
  bio             String
  drawDescription String    @map("draw_description")
  spotifyUrl      String?   @map("spotify_url")
  videoReelUrl    String?   @map("video_reel_url")
  epkUrl          String?   @map("epk_url")
  contactName     String    @map("contact_name")
  contactEmail    String    @map("contact_email")
  contactPhone    String?   @map("contact_phone")
  hometown        String?
  mailingAddress  String?   @map("mailing_address") // CAN-SPAM requires a physical postal address in commercial email
  instagramHandle String?   @map("instagram_handle")
  voicemailScript String?   @map("voicemail_script") // artist's personal voicemail template
  // ── Agent briefing depth — what makes Tulio sound like a real, versed agent ──
  soundsLike       String?  @map("sounds_like")        // comparable artists, e.g. "Gregory Alan Isakov, Iron & Wine"
  audienceProfile  String?  @map("audience_profile")   // who shows up: age, vibe, spend, e.g. "25-45, listening-room crowd, strong bar spend"
  performanceStyle String?  @map("performance_style")  // format: "solo acoustic, 2x45min sets, originals + tasteful covers"
  accolades        String?  // proof points: streams, press, notable rooms played
  bookingAgentName String   @default("Tulio") @map("booking_agent_name") // the AI agent's name on calls
  plan            String    @default("free") // free | pro | premium — gates daily send cap & paid features
  gemBalance      Int       @default(0) @map("gem_balance") // prepaid campaign currency
  stripeAccountId String?   @map("stripe_account_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  shows           Show[]
  venues          Venue[]
  outreach        Outreach[]
  calls           Call[]
  pipeline        Pipeline[]
  insights        Insight[]
  availability    ArtistAvailability[]
  enrichmentJobs  EnrichmentJob[]
  campaigns       Campaign[]
  gemTransactions GemTransaction[]
  autopilots      Autopilot[]
  playbookEnrollments PlaybookEnrollment[]

  @@map("artists")
}

// A venue's progress through the multi-step follow-up cadence (the ServiceNow
// "playbook" transplant): email → wait → call → wait → nudge → close. The
// runner advances each enrollment when its nextActionAt arrives, executing the
// step unless the venue has already engaged (then it converts/stops).
model PlaybookEnrollment {
  id           String   @id @default(cuid())
  artistId     String   @map("artist_id")
  venueId      String   @unique @map("venue_id")
  stepIndex    Int      @default(0) @map("step_index")
  status       String   @default("active") // active | converted | stopped | completed
  nextActionAt DateTime @map("next_action_at")
  lastActionAt DateTime? @map("last_action_at")
  lastReason   String?   @map("last_reason")
  createdAt    DateTime @default(now()) @map("created_at")

  artist Artist @relation(fields: [artistId], references: [id])
  venue  Venue  @relation(fields: [venueId], references: [id])

  @@index([status, nextActionAt])
  @@map("playbook_enrollments")
}

// "Always-on" daily-budget outreach (the Meta-Ads model). Each day, Gigify
// works down the best-ranked eligible leads — placing calls / sending emails —
// until the day's gem budget is spent, then resumes the next day. Paused or
// runs dry when the artist's gem balance is exhausted.
model Autopilot {
  id             String   @id @default(cuid())
  artistId       String   @map("artist_id")
  channel        String   // "call" | "email"
  dailyGemBudget Int      @map("daily_gem_budget")
  status         String   @default("active") // active | paused
  minLeadTier    String?  @map("min_lead_tier") // only contact leads at/above this tier (A|B|C|D)
  createdAt      DateTime @default(now()) @map("created_at")
  pausedAt       DateTime? @map("paused_at")

  artist       Artist           @relation(fields: [artistId], references: [id])
  transactions GemTransaction[]

  @@index([artistId])
  @@map("autopilots")
}

// Prepaid-currency ledger. Every gem purchase (+) and campaign spend (-) is a
// row, so the balance is always auditable and reconstructable.
model GemTransaction {
  id           String   @id @default(cuid())
  artistId     String   @map("artist_id")
  delta        Int      // + for purchases/grants, - for spends
  balanceAfter Int      @map("balance_after")
  reason       String   // "purchase" | "campaign" | "autopilot" | "grant" | "refund"
  campaignId   String?  @map("campaign_id")
  autopilotId  String?  @map("autopilot_id")
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")

  artist    Artist     @relation(fields: [artistId], references: [id])
  campaign  Campaign?  @relation(fields: [campaignId], references: [id])
  autopilot Autopilot? @relation(fields: [autopilotId], references: [id])

  @@index([artistId])
  @@index([autopilotId, createdAt])
  @@map("gem_transactions")
}

// A paid outreach campaign over a selected set of venues, orchestrated across
// several days and sending subdomains, ordered by proximity to the artist's
// nearest gig.
model Campaign {
  id            String   @id @default(cuid())
  artistId      String   @map("artist_id")
  channel       String   // "email" | "call"
  status        String   @default("scheduled") // scheduled | running | completed | cancelled
  venueCount    Int      @map("venue_count")
  gemCost       Int      @map("gem_cost")
  daysSpread    Int      @map("days_spread")    // calendar days the sends are spread across
  perDayCap     Int      @map("per_day_cap")
  subdomains    String[] @default([])           // sending subdomains rotated across
  startedAt     DateTime @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")

  artist       Artist           @relation(fields: [artistId], references: [id])
  items        CampaignItem[]
  transactions GemTransaction[]

  @@index([artistId])
  @@map("campaigns")
}

// One scheduled send/call within a campaign.
model CampaignItem {
  id            String   @id @default(cuid())
  campaignId    String   @map("campaign_id")
  venueId       String   @map("venue_id")
  rank          Int      // position in the proximity-ordered queue
  scheduledFor  DateTime @map("scheduled_for") // the day this item should go out
  sendingDomain String?  @map("sending_domain") // which subdomain this one uses (email)
  status        String   @default("pending")    // pending | sent | failed | skipped
  sentAt        DateTime? @map("sent_at")
  error         String?

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
  @@index([scheduledFor, status])
  @@map("campaign_items")
}

model ArtistAvailability {
  id        String           @id @default(cuid())
  artistId  String           @map("artist_id")
  type      BlockType
  date      DateTime         // the blocked date (time component ignored for allDay)
  allDay    Boolean          @default(true) @map("all_day")
  timeStart DateTime?        @map("time_start")
  timeEnd   DateTime?        @map("time_end")
  reason    String?          // "recording session", "travel", "family", etc.
  createdAt DateTime         @default(now()) @map("created_at")

  artist Artist @relation(fields: [artistId], references: [id])

  @@map("artist_availability")
}

enum BlockType {
  BLOCKED       // hard block — never suggest this date
  TRAVEL        // travel day — artist is moving but no show booked
  PREFERRED_OFF // soft block — would rather not, but will consider
}

model Show {
  id        String     @id @default(cuid())
  artistId  String     @map("artist_id")
  date      DateTime
  dayOfWeek String     @map("day_of_week")
  city      String
  state     String
  venueName String     @map("venue_name")
  address   String
  lat       Float
  lng       Float
  timeStart DateTime?  @map("time_start")
  timeEnd   DateTime?  @map("time_end")
  showType  String     @default("headline") @map("show_type")
  status    ShowStatus @default(CONFIRMED)
  revenue   Float?     // what Elijah actually earned at this gig
  fee       Float?     // what he charged / was booked for
  createdAt DateTime   @default(now()) @map("created_at")

  artist   Artist     @relation(fields: [artistId], references: [id])
  nearbyVenues Venue[] @relation("NearestShow")

  @@map("shows")
}

enum ShowStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Venue {
  id                   String   @id @default(cuid())
  name                 String
  city                 String
  state                String
  address              String
  lat                  Float
  lng                  Float
  phone                String?
  email                String?
  website              String?
  venueType            VenueType @map("venue_type")
  capacityEstimate     Int?     @map("capacity_estimate")
  decisionMakerName    String?  @map("decision_maker_name")
  decisionMakerRole    String?  @map("decision_maker_role")
  decisionMakerEmail   String?  @map("decision_maker_email")
  decisionMakerPhone   String?  @map("decision_maker_phone")
  notes                String?
  nearestShowId        String?  @map("nearest_show_id")
  distanceMiles        Float?   @map("distance_miles")
  googlePlaceId        String?  @map("google_place_id")
  optedOut             Boolean  @default(false) @map("opted_out") // unsubscribed — excluded from all sends
  source               String?

  // Venue intelligence — populated during enrichment scrape + Claude analysis.
  // Used by the email engine to personalize openers and by the lead-scoring
  // model to predict booking conversion.
  narrative            String?  // Short blurb from the venue's About / Story page
  rawAboutText         String?  @map("raw_about_text") // Truncated raw scrape, for future re-analysis
  hostsLiveMusic       Boolean? @map("hosts_live_music")
  genresHosted         String[] @map("genres_hosted")
  cuisine              String?
  vibe                 String[]
  priceRange           String?  @map("price_range") // "$" to "$$$$"
  foundedYear          Int?     @map("founded_year")
  instagramHandle      String?  @map("instagram_handle")
  facebookUrl          String?  @map("facebook_url")
  pastArtists          String[] @map("past_artists")
  narrativeFetchedAt   DateTime? @map("narrative_fetched_at")
  enrichAttemptedAt    DateTime? @map("enrich_attempted_at") // last time any scraper ran on this venue
  // Per-tier completion flags — once a tier fully processes a venue it's checked
  // off and skipped on re-runs at that tier (unless the venue website changes).
  freeEnrichedAt       DateTime? @map("free_enriched_at")    // Web Scrape tier done
  deepEnrichedAt       DateTime? @map("deep_enriched_at")    // Deep Scrape tier done
  premiumEnrichedAt    DateTime? @map("premium_enriched_at") // Talent Buyer tier done
  reviewsMinedAt       DateTime? @map("reviews_mined_at")    // Google reviews processed

  // Lead scoring — computed after enrichment
  fbFollowerCount      Int?     @map("fb_follower_count")
  privateEventsFriendly Boolean? @map("private_events_friendly")

  // Lead scoring
  leadScore            Int?     @map("lead_score")
  leadTier             String?  @map("lead_tier")  // "A" | "B" | "C" | "D"
  leadReason           String?  @map("lead_reason")

  artistId             String   @map("artist_id")
  createdAt            DateTime @default(now()) @map("created_at")

  artist      Artist     @relation(fields: [artistId], references: [id])
  nearestShow Show?      @relation("NearestShow", fields: [nearestShowId], references: [id])
  outreach    Outreach[]
  calls       Call[]
  pipeline    Pipeline?
  surveys     Survey[]
  playbookEnrollment PlaybookEnrollment?
  replies     InboundReply[]

  @@map("venues")
}

enum VenueType {
  BAR
  RESTAURANT
  MUSIC_CLUB
  ARTS_CENTER
  FARMERS_MARKET
  FESTIVAL
  OTHER
}

model Outreach {
  id               String         @id @default(cuid())
  venueId          String         @map("venue_id")
  artistId         String         @map("artist_id")
  channel          OutreachChannel
  status           OutreachStatus @default(QUEUED)
  subjectLine      String?        @map("subject_line")
  body             String?
  sentAt           DateTime?      @map("sent_at")
  openedAt         DateTime?      @map("opened_at")
  clickedAt        DateTime?      @map("clicked_at")
  sendgridMessageId String?       @map("sendgrid_message_id")
  variant          String?        @default("a")
  createdAt        DateTime       @default(now()) @map("created_at")

  venue  Venue  @relation(fields: [venueId], references: [id])
  artist Artist @relation(fields: [artistId], references: [id])

  @@map("outreach")
}

// A received email reply from a venue — the inbound side of the conversation.
// Stored so the Outreach inbox can show real threads, not just a "REPLIED" badge.
model InboundReply {
  id             String   @id @default(cuid())
  venueId        String   @map("venue_id")
  artistId       String?  @map("artist_id")
  fromEmail      String   @map("from_email")
  fromName       String?  @map("from_name")
  subject        String?
  text           String
  classification String?  // INTERESTED | OBJECTION | WRONG_PERSON | OUT_OF_OFFICE | DECLINED | UNKNOWN
  summary        String?
  receivedAt     DateTime @default(now()) @map("received_at")
  createdAt      DateTime @default(now()) @map("created_at")

  venue Venue @relation(fields: [venueId], references: [id])

  @@index([venueId, receivedAt])
  @@map("inbound_replies")
}

enum OutreachChannel {
  EMAIL
  CALL
  SMS
}

enum OutreachStatus {
  QUEUED
  SENT
  OPENED
  CLICKED
  REPLIED
  OPTED_OUT
}

model Call {
  id                  String     @id @default(cuid())
  venueId             String     @map("venue_id")
  artistId            String     @map("artist_id")
  twilioCallSid       String?    @map("twilio_call_sid")
  vapiCallId          String?    @map("vapi_call_id") // Vapi call id, correlates the end-of-call webhook
  status              CallStatus @default(QUEUED)
  durationSeconds     Int?       @map("duration_seconds")
  contactNameCaptured String?    @map("contact_name_captured")
  scriptVariant       String?    @map("script_variant")
  transcriptUrl       String?    @map("transcript_url")
  transcript          String?    // full transcript text (manual notes or STT)
  recordingUrl        String?    @map("recording_url")
  disposition         String?
  summary             String?
  nextAction          String?    @map("next_action")
  // AI call analysis — the data-moat layer. Ranks how the call went.
  callScore           Int?       @map("call_score")    // 0-100, likelihood the venue books
  callTier            String?    @map("call_tier")     // A | B | C | D
  sentiment           String?    // positive | neutral | negative
  analyzedAt          DateTime?  @map("analyzed_at")
  calledAt            DateTime?  @map("called_at")
  // ── Closed-on-the-call terms — what Tulio locked verbally before we send the link ──
  agreedToBook        Boolean    @default(false) @map("agreed_to_book")
  agreedDate          DateTime?  @map("agreed_date")        // the date the venue agreed to
  agreedTime          String?    @map("agreed_time")        // e.g. "7:30 PM" / "evening after 9 PM"
  agreedPrice         Float?     @map("agreed_price")       // the fee agreed on the call
  emailCaptured       String?    @map("email_captured")     // best email they gave for the booking link
  proposalSentAt      DateTime?  @map("proposal_sent_at")   // when we auto-emailed the booking link
  venueBookedThrough  String?    @map("venue_booked_through") // how far out they're booked, e.g. "through August" — for future-routing follow-up

  venue  Venue  @relation(fields: [venueId], references: [id])
  artist Artist @relation(fields: [artistId], references: [id])

  @@map("calls")
}

enum CallStatus {
  QUEUED
  INITIATED
  ANSWERED
  VOICEMAIL
  NO_ANSWER
  FAILED
}

model Pipeline {
  id                    String        @id @default(cuid())
  venueId               String        @unique @map("venue_id")
  artistId              String        @map("artist_id")
  stage                 PipelineStage @default(QUEUED)
  emailOpened           Boolean       @default(false) @map("email_opened")
  callStatus            String?       @map("call_status")
  depositAmount         Float?        @map("deposit_amount")
  depositPaidAt         DateTime?     @map("deposit_paid_at")
  stripePaymentIntentId String?       @map("stripe_payment_intent_id")
  cancellationDeadline  DateTime?     @map("cancellation_deadline")
  cancelledAt           DateTime?     @map("cancelled_at")
  refundIssuedAt        DateTime?     @map("refund_issued_at")
  contractSentAt        DateTime?     @map("contract_sent_at")
  contractSignedAt      DateTime?     @map("contract_signed_at")
  bookedShowDate        DateTime?     @map("booked_show_date")
  bookedShowFee         Float?        @map("booked_show_fee")
  notes                 String?
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  venue   Venue    @relation(fields: [venueId], references: [id])
  artist  Artist   @relation(fields: [artistId], references: [id])
  surveys Survey[]
  agreement BookingAgreement?

  @@map("pipeline")
}

// A confirmed booking's performance agreement (clickwrap). The gig fee settles
// however the venue chooses (deposit online or cash on the night); the Gigify
// booking fee is recorded here for collection regardless.
model BookingAgreement {
  id             String   @id @default(cuid())
  pipelineId     String   @unique @map("pipeline_id")
  venueId        String   @map("venue_id")
  artistId       String   @map("artist_id")
  showDate       DateTime? @map("show_date")
  startTime      String?  @map("start_time")
  gigFee         Float?   @map("gig_fee")
  depositAmount  Int      @map("deposit_amount")
  gigifyFee      Int      @map("gigify_fee")
  settleMethod   String   @map("settle_method") // deposit | cash
  terms          String[] // snapshot of the accepted clauses
  acceptedByName String   @map("accepted_by_name")
  acceptedByEmail String  @map("accepted_by_email")
  acceptedAt     DateTime @default(now()) @map("accepted_at")
  feePaid        Boolean  @default(false) @map("fee_paid") // Gigify booking fee collected
  createdAt      DateTime @default(now()) @map("created_at")

  pipeline Pipeline @relation(fields: [pipelineId], references: [id])

  @@map("booking_agreements")
}

enum PipelineStage {
  QUEUED
  EMAILED
  CALLED
  INTERESTED
  DEPOSIT
  BOOKED
  CANCELLED
  DECLINED
}

model Survey {
  id         String     @id @default(cuid())
  pipelineId String     @map("pipeline_id")
  venueId    String     @map("venue_id")
  surveyType SurveyType @map("survey_type")
  q1Answer   String?    @map("q1_answer")
  q2Answer   String?    @map("q2_answer")
  q3Answer   String?    @map("q3_answer")
  q4Answer   String?    @map("q4_answer")
  q5Answer   String?    @map("q5_answer")
  completedAt DateTime? @map("completed_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  pipeline Pipeline @relation(fields: [pipelineId], references: [id])
  venue    Venue    @relation(fields: [venueId], references: [id])

  @@map("surveys")
}

enum SurveyType {
  POST_BOOKING
  DAY_AFTER
}

// Background job tracker — enrichment runs server-side and persists
// progress so the user can navigate freely without stopping the job.
model EnrichmentJob {
  id            String    @id @default(cuid())
  artistId      String    @map("artist_id")
  tier          String    // "free" | "deep" | "premium"
  status        String    @default("running") // running | completed | cancelled | error
  attempted     Int       @default(0)
  enriched      Int       @default(0)
  noMatch       Int       @default(0)
  skipped       Int       @default(0)
  totalShows    Int       @default(0) @map("total_shows")
  showsDone     Int       @default(0) @map("shows_done")
  currentShow   String?   @map("current_show") // e.g. "Cambridge, MA"
  phase         String    @default("enrich")  // prune | repair | enrich | mine_reviews | score | done
  pruned        Int       @default(0)
  repaired      Int       @default(0)
  reviewsMined  Int       @default(0)  @map("reviews_mined")
  errorMsg      String?   @map("error_msg")
  startedAt     DateTime  @default(now()) @map("started_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") // heartbeat — bumped on every progress write
  completedAt   DateTime? @map("completed_at")

  artist Artist @relation(fields: [artistId], references: [id])

  @@map("enrichment_jobs")
}

model Insight {
  id          String   @id @default(cuid())
  artistId    String   @map("artist_id")
  signal      String
  stat        String?
  action      String
  impact      String
  sourceData  String?  @map("source_data")
  generatedAt DateTime @default(now()) @map("generated_at")
  active      Boolean  @default(true)

  artist Artist @relation(fields: [artistId], references: [id])

  @@map("insights")
}
